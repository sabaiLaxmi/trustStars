<div class="truststars-form-embed-wrapper" style="width: 100%; margin: 20px 0;">
  {% if block.settings.form_id != blank %}
    <iframe 
      src="{{ shop.url }}/apps/truststars/{{ block.settings.form_id }}?embedded=true&shop={{ shop.domain }}" 
      width="100%" 
      height="{{ block.settings.iframe_height }}px" 
      style="border: none; overflow: hidden; display: block;" 
      scrolling="no"
    ></iframe>
  {% else %}
    <div style="padding: 40px; border: 2px dashed #E5E7EB; text-align: center; background: #F9FAFB; border-radius: 8px;">
      <h3 style="margin: 0 0 10px 0; color: #111827;">TrustStars Form</h3>
      <p style="margin: 0; color: #6B7280;">Please enter your Form ID in the block settings on the right.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "TrustStars Form",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "form_id",
      "label": "Form ID",
      "info": "Copy the Form ID from your TrustStars app dashboard"
    },
    {
      "type": "number",
      "id": "iframe_height",
      "label": "Form Height (px)",
      "default": 600,
      "info": "Adjust this to fit your form without scrolling"
    }
  ]
}
{% endschema %}
