{% schema %}
{
  "name": "TrustStars Contact Form",
  "target": "section",
  "stylesheet": "contact_form.css",
  "javascript": "contact_form.js",
  "settings": [
    {
      "type": "text",
      "id": "form_id",
      "label": "Which form? (Paste Form ID)",
      "info": "To find this, open your form in the TrustStars app and copy the ID from the URL. Leave blank to automatically load your first form."
    }
  ]
}
{% endschema %}

{% assign active_form_id = block.settings.form_id %}
{% if active_form_id == blank %}
  {% assign active_form_id = "default" %}
{% endif %}

<div class="ts-contact-form-wrapper ts-block-wrapper" id="ts-contact-form-{{ block.id }}" data-block-id="{{ block.id }}" data-form-id="{{ active_form_id }}">
  <div id="ts-form-container-{{ block.id }}" class="ts-form-container">
    <div style="text-align: center; padding: 20px;" class="ts-loading-state">Loading form...</div>
  </div>
</div>
