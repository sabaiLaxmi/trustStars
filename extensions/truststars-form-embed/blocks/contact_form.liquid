{% schema %}
{
  "name": "TrustStars Contact Form",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "form_id",
      "label": "Form ID",
      "info": "Enter the ID of the form you want to display."
    },
    {
      "type": "range",
      "id": "iframe_height",
      "min": 400,
      "max": 1000,
      "step": 50,
      "label": "Form Height (px)",
      "default": 600
    }
  ]
}
{% endschema %}

<div class="ts-contact-form-wrapper" id="ts-contact-form-{{ block.id }}">
  {% if block.settings.form_id != blank %}
    <iframe 
      src="/apps/truststars/{{ block.settings.form_id }}" 
      width="100%" 
      height="{{ block.settings.iframe_height }}px" 
      frameborder="0"
      style="border: none; overflow: hidden;"
    ></iframe>
  {% else %}
    <div style="padding: 40px; text-align: center; background: #f4f6f8; border-radius: 8px;">
      <p style="margin: 0; color: #333; font-family: sans-serif;">Please enter a Form ID in the block settings to display your form.</p>
    </div>
  {% endif %}
</div>
